{
  "headers": [
    {
      "source": "/assets/models/(.*)",
      "headers": [
        {
          "key": "Content-Encoding",
          "value": "identity"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable, no-transform"
        }
      ]
    }
  ]
}
